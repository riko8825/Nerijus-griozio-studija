# =====================================
# AKVA STUDIO — Environment variables
# =====================================
# Kopijuok šį failą į .env (lokaliai) arba įvesk į Vercel dashboard'ą.
# .env yra .gitignore'inta — niekada NEcommit'inti į git.

# === SANITY CMS ===
# Gauk per https://manage.sanity.io po projekto sukūrimo.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-01-01

# Read-only token (frontend gali matyti) — NAUDOJAMAS BUILD'O metu draft preview'iui.
# Production deploy'uose nereikalingas (published content yra public per CDN).
SANITY_PUBLIC_TOKEN=

# Write token (TIK build scripts'ams — niekada frontend kode!)
# Naudojamas scripts/fetch-sanity-data.mjs jei reikia draft access.
SANITY_DEPLOY_TOKEN=

# === STUDIO (atskira sub-projektas) ===
# Sutampa su SANITY_PROJECT_ID, bet Studio reikia savo prefix'o.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# === VERCEL (auto-injected) ===
# VERCEL_URL=
# VERCEL_ENV=production|preview|development

# === ATEIČIAI — F2 fazė (mokėjimai). NEPILDYTI dabar. ===
# STRIPE_PUBLIC_KEY=
# STRIPE_SECRET_KEY=
# VIPPS_CLIENT_ID=
# VIPPS_CLIENT_SECRET=
# RESEND_API_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
